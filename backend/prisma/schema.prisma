generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  EMPLOYEE
  OWNER
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  WEB
  ADMIN
}

enum PaymentType {
  FULL
  DEPOSIT
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationType {
  BOOKING_CONFIRMATION
  REMINDER
  CANCELLATION
  RESCHEDULE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedSalons        Salon[]           @relation("SalonOwner")
  employeeProfiles   EmployeeProfile[]
  clientAppointments Appointment[]     @relation("ClientAppointments")
  reviews            Review[]
  notifications      Notification[]
  auditLogs          AuditLog[]        @relation("AuditActor")

  @@map("users")
}

model Salon {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  addressLine String?  @map("address_line") @db.VarChar(255)
  city        String?  @db.VarChar(100)
  postalCode  String?  @map("postal_code") @db.VarChar(20)
  phone       String?  @db.VarChar(30)
  email       String?  @db.VarChar(255)
  logoUrl     String?  @map("logo_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner             User                @relation("SalonOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  employeeProfiles  EmployeeProfile[]
  serviceCategories ServiceCategory[]
  services          Service[]
  workingHours      SalonWorkingHours[]
  galleryImages     GalleryImage[]
  appointments      Appointment[]
  reviews           Review[]

  @@map("salons")
}

model EmployeeProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  salonId   String   @map("salon_id") @db.Uuid
  position  String?  @db.VarChar(100)
  bio       String?
  photoUrl  String?  @map("photo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user             User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  salon            Salon              @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employeeServices EmployeeService[]
  schedules        EmployeeSchedule[]
  appointments     Appointment[]

  @@unique([userId, salonId])
  @@map("employee_profiles")
}

model ServiceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  salonId     String   @map("salon_id") @db.Uuid
  name        String   @db.VarChar(150)
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services Service[]

  @@map("service_categories")
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  salonId         String   @map("salon_id") @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  name            String   @db.VarChar(255)
  description     String?
  imageUrl        String?  @map("image_url")
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int      @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  salon            Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  category         ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  employeeServices EmployeeService[]
  appointments     Appointment[]

  @@map("services")
}

model EmployeeService {
  id                String   @id @default(uuid()) @db.Uuid
  employeeProfileId String   @map("employee_profile_id") @db.Uuid
  serviceId         String   @map("service_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, serviceId])
  @@map("employee_services")
}

model SalonWorkingHours {
  id        String   @id @default(uuid()) @db.Uuid
  salonId   String   @map("salon_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week")
  openTime  String?  @map("open_time") @db.VarChar(5)
  closeTime String?  @map("close_time") @db.VarChar(5)
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, dayOfWeek])
  @@map("salon_working_hours")
}

model EmployeeSchedule {
  id                String   @id @default(uuid()) @db.Uuid
  employeeProfileId String   @map("employee_profile_id") @db.Uuid
  dayOfWeek         Int      @map("day_of_week")
  startTime         String?  @map("start_time") @db.VarChar(5)
  endTime           String?  @map("end_time") @db.VarChar(5)
  isWorking         Boolean  @default(true) @map("is_working")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, dayOfWeek])
  @@map("employee_schedules")
}

model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  salonId           String            @map("salon_id") @db.Uuid
  clientId          String            @map("client_id") @db.Uuid
  employeeProfileId String            @map("employee_profile_id") @db.Uuid
  serviceId         String            @map("service_id") @db.Uuid
  startTime         DateTime          @map("start_time")
  endTime           DateTime          @map("end_time")
  status            AppointmentStatus @default(BOOKED)
  bookingSource     BookingSource     @default(WEB) @map("booking_source")
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  salon           Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  client          User            @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Restrict)
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Restrict)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  review          Review?
  payments        Payment[]
  notifications   Notification[]

  @@index([salonId])
  @@index([clientId])
  @@index([employeeProfileId])
  @@index([serviceId])
  @@index([startTime, endTime])
  @@map("appointments")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  appointmentId String        @map("appointment_id") @db.Uuid
  amount        Decimal       @db.Decimal(10, 2)
  paymentType   PaymentType   @map("payment_type")
  status        PaymentStatus @default(PENDING)
  provider      String?       @db.VarChar(50)
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id            String   @id @default(uuid()) @db.Uuid
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  salonId       String   @map("salon_id") @db.Uuid
  rating        Int
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client      User        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  salon       Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model GalleryImage {
  id          String   @id @default(uuid()) @db.Uuid
  salonId     String   @map("salon_id") @db.Uuid
  imageUrl    String   @map("image_url")
  title       String?  @db.VarChar(255)
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@map("gallery_images")
}

model Notification {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  appointmentId String?             @map("appointment_id") @db.Uuid
  channel       NotificationChannel
  type          NotificationType
  status        NotificationStatus  @default(PENDING)
  sentAt        DateTime?           @map("sent_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
