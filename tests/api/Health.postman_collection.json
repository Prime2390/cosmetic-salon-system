      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response time is below 1000 ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test('Message equals \"API is working\"', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql(\"API is working\");",
              "});",
              "",
              "pm.test('Database status equals \"connected\"', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.database).to.eql(\"connected\");",
              "});",
              "",
              "pm.test(\"Response has required fields\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"message\");",
              "    pm.expect(jsonData).to.have.property(\"database\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
