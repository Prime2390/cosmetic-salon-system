    {
      "name": "Register",
      "item": [
        {
          "name": "Positive",
          "item": [
            {
              "name": "Register user with valid data",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 201\", function () {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "pm.test(\"Response is JSON\", function () {",
                      "    pm.response.to.be.json;",
                      "});",
                      "",
                      "pm.test(\"Response time is below 1000 ms\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                      "});",
                      "",
                      "const jsonData = pm.response.json();",
                      "",
                      "pm.test(\"Response contains success message\", function () {",
                      "    pm.expect(jsonData.message).to.eql(\"User register successfully\");",
                      "});",
                      "",
                      "pm.test(\"Response contains user object\", function () {",
                      "    pm.expect(jsonData).to.have.property(\"user\");",
                      "});",
                      "",
                      "pm.test(\"User object contains required fields\", function () {",
                      "    pm.expect(jsonData.user).to.have.property(\"id\");",
                      "    pm.expect(jsonData.user).to.have.property(\"firstName\");",
                      "    pm.expect(jsonData.user).to.have.property(\"lastName\");",
                      "    pm.expect(jsonData.user).to.have.property(\"email\");",
                      "    pm.expect(jsonData.user).to.have.property(\"role\");",
                      "    pm.expect(jsonData.user).to.have.property(\"createdAt\");",
                      "});",
                      "",
                      "pm.test(\"Returned user data is correct\", function () {",
                      "    pm.expect(jsonData.user.firstName).to.eql(pm.collectionVariables.get(\"registerFirstName\"));",
                      "    pm.expect(jsonData.user.lastName).to.eql(pm.collectionVariables.get(\"registerLastName\"));",
                      "    pm.expect(jsonData.user.email).to.eql(pm.collectionVariables.get(\"registerEmail\"));",
                      "    pm.expect(jsonData.user.role).to.eql(\"CLIENT\");",
                      "});",
                      "",
                      "pm.test(\"Response does not expose password hash\", function () {",
                      "    pm.expect(jsonData.user).to.not.have.property(\"passwordHash\");",
                      "});",
                      "",
                      "pm.test(\"User id is not empty\", function () {",
                      "    pm.expect(jsonData.user.id).to.not.be.empty;",
                      "});",
                      "",
                      "pm.collectionVariables.set(\"loginEmail\", jsonData.user.email);",
                      "pm.collectionVariables.set(\"loginPassword\", pm.collectionVariables.get(\"registerPassword\"));"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "const uniqueId = Date.now();",
                      "const testEmail = `dominik.test.${uniqueId}@example.com`;",
                      "",
                      "pm.collectionVariables.set(\"registerEmail\", testEmail);",
                      "pm.collectionVariables.set(\"registerFirstName\", \"Dominik\");",
                      "pm.collectionVariables.set(\"registerLastName\", \"Bernas\");",
                      "pm.collectionVariables.set(\"registerPassword\", \"Test1234!\");"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstName\": \"{{registerFirstName}}\",\n  \"lastName\": \"{{registerLastName}}\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{apiUrl}}/auth/register",
                  "host": [
                    "{{apiUrl}}"
                  ],
                  "path": [
                    "auth",
                    "register"
                  ]
                },
                "description": "Creates a new user account with valid registration data.\n\nExpected result:\n\n\\- HTTP 201\n\n\\- response contains success message\n\n\\- response contains created user data\n\n\\- response does not expose passwordHash\n\n\\- user role is set to CLIENT"
